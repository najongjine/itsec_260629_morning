# PostgreSQL/Neon connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ImgBB API key used by product image uploads
IMGBB_API_KEY=replace-with-your-imgbb-api-key

# Generate a long random value (for example: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Exactly 16, 24, or 32 UTF-8 bytes. Keep the old value if encrypted data exists.
AES_KEY=replace-with-32-byte-secret-key!
